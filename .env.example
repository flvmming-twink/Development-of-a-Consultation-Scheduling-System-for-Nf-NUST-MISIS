# Run python scripts/configure.py once to generate .env with random infrastructure secrets.
DATABASE_URL=postgresql+psycopg://consult_app:CHANGE_ME@localhost:5432/consultations
SECRET_KEY=CHANGE_ME
POSTGRES_DB=consultations
POSTGRES_USER=consult_app
POSTGRES_PASSWORD=CHANGE_ME
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
APP_TIMEZONE=Asia/Yekaterinburg
CORPORATE_DOMAIN=misis.ru
BOOKING_LEAD_HOURS=48
COOKIE_SECURE=0
FORCE_INITIAL_PASSWORD_CHANGE=0
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_BIND=127.0.0.1
APP_PORT=8000
